    "exclude": ["/assets/*", "/*.js", "/*.css", "/*.png", "/*.jpg", "/*.ico", "/*.ttf"]
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; img-src 'self' https://raw.githubusercontent.com https://pokeapi.co data:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://pokeapi.co;",
    "Content-Security-Policy": "default-src 'self' https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; img-src 'self' https: data:;",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
  }
}
